NODE_ENV=development
PORT=5000
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_USER=test@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password
EMAIL_PROVIDER=gmail

# Browser / CORS
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Only honored when NODE_ENV=development; reflects any request origin.
CORS_ALLOW_ALL_ORIGINS=false
CORS_MAX_AGE_SECONDS=600
FRONTEND_URL=http://localhost:3000

# Auth cookies
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
# lax | strict | none. Use none + COOKIE_SECURE=true only for cross-site cookies.
COOKIE_SAMESITE=lax
# Must be true when COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CSRF (double-submit cookie)
CSRF_COOKIE_NAME=csrf_token
CSRF_TOKEN_TTL_MINUTES=60

# OTP / rate limiting
# Required in production. Generate with: openssl rand -hex 32
OTP_PEPPER=replace_with_a_random_pepper
OTP_LENGTH=6
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Cache configuration
CACHE_PROVIDER=memory
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=auth:

# Brevo SMTP configuration (used when EMAIL_PROVIDER=brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=BrightAuth
